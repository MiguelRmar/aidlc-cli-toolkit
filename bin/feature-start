#!/usr/bin/env node
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const https = require('node:https');
const { spawnSync } = require('node:child_process');
const readline = require('node:readline/promises');
const { stdin: input, stdout: output } = require('node:process');

// ============================================================================
// GESTOR DE CONFIGURACIÓN & ONBOARDING INTERACTIVO
// ============================================================================
const CONFIG_DIR = path.join(os.homedir(), '.config', 'aidlc');
const CONFIG_FILE = path.join(CONFIG_DIR, 'config.env');

function loadPersistentEnv() {
  if (fs.existsSync(CONFIG_FILE)) {
    try {
      const content = fs.readFileSync(CONFIG_FILE, 'utf8');
      content.split('\n').forEach(line => {
        const trimmed = line.trim();
        if (trimmed && !trimmed.startsWith('#') && trimmed.includes('=')) {
          const idx = trimmed.indexOf('=');
          const key = trimmed.slice(0, idx).trim();
          let val = trimmed.slice(idx + 1).trim();
          if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
            val = val.slice(1, -1);
          }
          if (!process.env[key]) {
            process.env[key] = val;
          }
        }
      });
    } catch {}
  }
}

// Cargar variables persistentes guardadas anteriormente
loadPersistentEnv();

function isPlaceholderOrEmpty(val) {
  if (!val || typeof val !== 'string' || !val.trim()) return true;
  const lower = val.toLowerCase().trim();
  const placeholders = ['tu-dominio', 'tu-organizacion', 'tu-correo', 'tu-empresa', 'tu-api-token', 'tu-gemini-api-key', 'tu-figma-token'];
  return placeholders.some(p => lower.includes(p));
}

async function runInteractiveOnboarding(force = false) {
  const aiProvider = (process.env.PREFERRED_AI_PROVIDER || '').toLowerCase().trim();
  const needsGeminiKey = (!aiProvider || aiProvider === 'gemini') && isPlaceholderOrEmpty(process.env.GEMINI_API_KEY);

  const needsConfig =
    force ||
    isPlaceholderOrEmpty(process.env.PROJECTS_BASE_DIR) ||
    isPlaceholderOrEmpty(process.env.JIRA_URL) ||
    isPlaceholderOrEmpty(process.env.CONFLUENCE_URL) ||
    isPlaceholderOrEmpty(process.env.JIRA_USERNAME) ||
    isPlaceholderOrEmpty(process.env.JIRA_API_TOKEN) ||
    (!aiProvider && needsGeminiKey) ||
    (aiProvider === 'gemini' && needsGeminiKey);

  if (!needsConfig) return;

  console.log("\n=================================================================================");
  console.log("👋 ¡BIENVENIDO AL ENTORNO AI-DLC & SPEC-DRIVEN DEVELOPMENT (SDD)!");
  console.log("=================================================================================");
  if (force) {
    console.log("Modo reconfiguración (--setup): Presiona [Enter] para mantener el valor actual o escribe uno nuevo.\n");
  } else {
    console.log("Hemos detectado que faltan configuraciones o es la primera vez que ejecutas 'feature-start'.");
    console.log("Vamos a configurar tus accesos de forma guiada para que todo funcione sin fricción.\n");
  }

  const rl = readline.createInterface({ input, output });

  try {
    // 1. Directorio(s) base de proyectos
    if (force || isPlaceholderOrEmpty(process.env.PROJECTS_BASE_DIR)) {
      const currentProjects = !isPlaceholderOrEmpty(process.env.PROJECTS_BASE_DIR)
        ? process.env.PROJECTS_BASE_DIR
        : path.join(os.homedir(), 'Documents', 'GitHub');
      console.log("📁 1. Carpeta(s) donde guardas tus repositorios Git:");
      console.log(`   (Busca automáticamente en subcarpetas como backend/, frontend/, etc.)`);
      console.log(`   (También puedes poner varias rutas separadas por coma)`);
      const dirAnswer = await rl.question(`👉 Ingresa la(s) ruta(s) [Enter = ${currentProjects}]: `);
      const rawPaths = (dirAnswer.trim() || currentProjects)
        .split(/[,;]+/)
        .map(p => p.trim())
        .filter(Boolean)
        .map(p => (p.startsWith('~/') ? path.join(os.homedir(), p.slice(2)) : p))
        .map(p => path.resolve(p));
      process.env.PROJECTS_BASE_DIR = rawPaths.join(',');
      console.log(`   ✔ Repositorios configurados en: ${process.env.PROJECTS_BASE_DIR}\n`);
    }

    // 2. Jira Base URL
    if (force || isPlaceholderOrEmpty(process.env.JIRA_URL)) {
      const currJira = !isPlaceholderOrEmpty(process.env.JIRA_URL) ? process.env.JIRA_URL : '';
      console.log("🌐 2. URL de tu instancia Jira (Atlassian):");
      console.log("   (Ejemplo: https://mi-organizacion.atlassian.net)");
      while (true) {
        const jAns = await rl.question(currJira ? `👉 URL de Jira [Enter = ${currJira}]: ` : "👉 URL de Jira: ");
        const val = (jAns.trim() || currJira).replace(/\/+$/, '');
        if (!isPlaceholderOrEmpty(val)) {
          process.env.JIRA_URL = val;
          break;
        }
      }
      console.log(`   ✔ Jira URL: ${process.env.JIRA_URL}\n`);
    }

    // 3. Confluence URL
    if (force || isPlaceholderOrEmpty(process.env.CONFLUENCE_URL)) {
      const defaultConfluence = !isPlaceholderOrEmpty(process.env.CONFLUENCE_URL)
        ? process.env.CONFLUENCE_URL
        : `${process.env.JIRA_URL}/wiki`;
      console.log("📚 3. URL de Confluence (Atlassian Wiki):");
      const cAns = await rl.question(`👉 URL de Confluence [Enter = ${defaultConfluence}]: `);
      process.env.CONFLUENCE_URL = (cAns.trim() || defaultConfluence).replace(/\/+$/, '');
      console.log(`   ✔ Confluence URL: ${process.env.CONFLUENCE_URL}\n`);
    }

    // 4. Jira Username
    if (force || isPlaceholderOrEmpty(process.env.JIRA_USERNAME)) {
      const currUser = !isPlaceholderOrEmpty(process.env.JIRA_USERNAME) ? process.env.JIRA_USERNAME : '';
      console.log("📧 4. Correo de tu cuenta Atlassian (Jira / Confluence):");
      console.log("   (Ejemplo: nombre.apellido@empresa.com)");
      while (true) {
        const uAns = await rl.question(currUser ? `👉 Correo corporativo [Enter = ${currUser}]: ` : "👉 Correo corporativo: ");
        const val = uAns.trim() || currUser;
        if (!isPlaceholderOrEmpty(val)) {
          process.env.JIRA_USERNAME = val;
          break;
        }
      }
      console.log(`   ✔ Usuario: ${process.env.JIRA_USERNAME}\n`);
    }

    // 5. Jira API Token
    if (force || isPlaceholderOrEmpty(process.env.JIRA_API_TOKEN)) {
      const currTok = !isPlaceholderOrEmpty(process.env.JIRA_API_TOKEN) ? process.env.JIRA_API_TOKEN : '';
      console.log("🔑 5. API Token de Atlassian:");
      console.log("   Puedes crearlo en: https://id.atlassian.com/manage-profile/security/api-tokens");
      while (true) {
        const tokAns = await rl.question(currTok ? "👉 Token de Jira [Enter = mantener actual]: " : "👉 Token de Jira: ");
        const val = tokAns.trim() || currTok;
        if (!isPlaceholderOrEmpty(val)) {
          process.env.JIRA_API_TOKEN = val;
          break;
        }
      }
      console.log("   ✔ Token de Jira registrado.\n");
    }

    // 6. Motor de IA preferido para generar el plan SDD
    if (force || !process.env.PREFERRED_AI_PROVIDER) {
      const currAi = process.env.PREFERRED_AI_PROVIDER || 'gemini';
      console.log("🤖 6. Motor de IA para generar la especificación técnica (SDD):");
      console.log("   1) ✨ Google Gemini API (Requiere API Key gratuita o de pago)");
      console.log("   2) 🐙 GitHub Copilot CLI (Usa tu licencia de GitHub Copilot)");
      console.log("   3) 🧠 Claude (Claude Code CLI con tu suscripción o Anthropic API Key)");
      console.log("   4) 🛡️  Kiro / IDE Local (Self-Bootstrap: sin APIs externas; tu IDE genera el plan)");
      const aiAns = await rl.question(`👉 Selecciona tu motor preferido [1/2/3/4, Enter = ${currAi}]: `);
      const aiChoice = (aiAns.trim() || currAi).toLowerCase();
      if (aiChoice === '2' || aiChoice === 'copilot') {
        process.env.PREFERRED_AI_PROVIDER = 'copilot';
      } else if (aiChoice === '3' || aiChoice === 'claude' || aiChoice === 'anthropic') {
        process.env.PREFERRED_AI_PROVIDER = 'claude';
      } else if (aiChoice === '4' || aiChoice === 'kiro' || aiChoice === 'local') {
        process.env.PREFERRED_AI_PROVIDER = 'kiro';
      } else {
        process.env.PREFERRED_AI_PROVIDER = 'gemini';
      }
      console.log(`   ✔ Motor seleccionado: ${process.env.PREFERRED_AI_PROVIDER}\n`);
    }

    // 6b. Gemini API Key (Solo obligatoria si eligió Gemini)
    if (process.env.PREFERRED_AI_PROVIDER === 'gemini' && (force || isPlaceholderOrEmpty(process.env.GEMINI_API_KEY))) {
      const currGem = !isPlaceholderOrEmpty(process.env.GEMINI_API_KEY) ? process.env.GEMINI_API_KEY : '';
      console.log("🔑 6b. Google Gemini API Key:");
      console.log("   Puedes obtener tu API Key en: https://aistudio.google.com/app/apikey");
      while (true) {
        const gAns = await rl.question(currGem ? "👉 Gemini API Key [Enter = mantener actual]: " : "👉 Gemini API Key: ");
        const val = gAns.trim() || currGem;
        if (!isPlaceholderOrEmpty(val)) {
          process.env.GEMINI_API_KEY = val;
          break;
        }
      }
      console.log("   ✔ API Key de Gemini registrada.\n");
    }

    // 6c. Claude (CLI con suscripción o Anthropic API Key opcional)
    if (process.env.PREFERRED_AI_PROVIDER === 'claude' && (force || isPlaceholderOrEmpty(process.env.ANTHROPIC_API_KEY))) {
      const currAnth = !isPlaceholderOrEmpty(process.env.ANTHROPIC_API_KEY) ? process.env.ANTHROPIC_API_KEY : '';
      const hasClaudeCli = runCli('claude', ['--version'], { timeout: 3000 }).status === 0;
      if (hasClaudeCli) {
        console.log("   ✔ Claude Code CLI detectado. Usará tu suscripción de Claude directamente.");
      } else {
        console.log("   ℹ️  No se detectó 'claude' CLI en tu PATH (puedes instalarlo con: npm i -g @anthropic-ai/claude-code).");
      }
      const cAns = await rl.question(currAnth ? "👉 Anthropic API Key [Enter = mantener actual]: " : "👉 Anthropic API Key (opcional si usas Claude Code CLI, Enter para omitir): ");
      if (cAns.trim()) {
        process.env.ANTHROPIC_API_KEY = cAns.trim();
        console.log("   ✔ API Key de Anthropic registrada.\n");
      } else if (currAnth) {
        console.log("   ✔ API Key de Anthropic mantenida.\n");
      } else {
        console.log("   ✔ Se usará Claude Code CLI (o respaldo local).\n");
      }
    }

    // 7. Figma Access Token (Opcional)
    if (force || isPlaceholderOrEmpty(process.env.FIGMA_ACCESS_TOKEN)) {
      const currFig = !isPlaceholderOrEmpty(process.env.FIGMA_ACCESS_TOKEN) ? process.env.FIGMA_ACCESS_TOKEN : '';
      console.log("🎨 7. Figma Personal Access Token (Opcional):");
      console.log("   Si el ticket tiene mockups en Figma, descargará componentes automáticamente.");
      const fAns = await rl.question(currFig ? "👉 Token de Figma [Enter = mantener actual]: " : "👉 Token de Figma (o presiona Enter para omitir): ");
      if (fAns.trim()) {
        process.env.FIGMA_ACCESS_TOKEN = fAns.trim();
        console.log("   ✔ Token de Figma registrado.\n");
      } else if (!currFig) {
        console.log("   ℹ️  Figma omitido temporalmente.\n");
      }
    }

    // Guardar archivo persistente con permisos 0600
    fs.mkdirSync(CONFIG_DIR, { recursive: true });
    const envLines = [
      `# Configuración automática AI-DLC & feature-start`,
      `# Actualizado el ${new Date().toISOString()}`,
      `PROJECTS_BASE_DIR="${process.env.PROJECTS_BASE_DIR}"`,
      `JIRA_URL="${process.env.JIRA_URL}"`,
      `CONFLUENCE_URL="${process.env.CONFLUENCE_URL}"`,
      `JIRA_USERNAME="${process.env.JIRA_USERNAME}"`,
      `JIRA_API_TOKEN="${process.env.JIRA_API_TOKEN}"`,
      `CONFLUENCE_USERNAME="${process.env.JIRA_USERNAME}"`,
      `CONFLUENCE_API_TOKEN="${process.env.JIRA_API_TOKEN}"`,
      `PREFERRED_AI_PROVIDER="${process.env.PREFERRED_AI_PROVIDER || 'gemini'}"`,
      !isPlaceholderOrEmpty(process.env.GEMINI_API_KEY) ? `GEMINI_API_KEY="${process.env.GEMINI_API_KEY}"` : '',
      !isPlaceholderOrEmpty(process.env.ANTHROPIC_API_KEY) ? `ANTHROPIC_API_KEY="${process.env.ANTHROPIC_API_KEY}"` : '',
      !isPlaceholderOrEmpty(process.env.FIGMA_ACCESS_TOKEN) ? `FIGMA_ACCESS_TOKEN="${process.env.FIGMA_ACCESS_TOKEN}"` : '',
      process.env.PREFERRED_EDITOR ? `PREFERRED_EDITOR="${process.env.PREFERRED_EDITOR}"` : '',
    ].filter(Boolean).join('\n') + '\n';

    fs.writeFileSync(CONFIG_FILE, envLines, { mode: 0o600 });
    console.log("=================================================================================");
    console.log(`✅ ¡Configuración guardada exitosamente en ${CONFIG_FILE}!`);
    console.log("No volverá a pedírtela. Si en el futuro necesitas actualizarla, puedes editar ese archivo.");
    console.log("=================================================================================\n");
  } finally {
    rl.close();
  }
}

// ============================================================================
// CONFIGURACIÓN DINÁMICA
// ============================================================================
const CONFIG = {
  get projectsBaseDirs() {
    const raw = process.env.PROJECTS_BASE_DIR || path.join(os.homedir(), 'Documents', 'GitHub');
    return raw
      .split(/[,;]+/)
      .map(p => p.trim())
      .filter(Boolean)
      .map(p => (p.startsWith('~/') ? path.join(os.homedir(), p.slice(2)) : p))
      .map(p => path.resolve(p));
  },
  get projectsBaseDir() {
    return this.projectsBaseDirs[0];
  },
  quotaRegex: /exceeded your monthly quota|rate limit|AI Credits 0|429|unauthorized|error:/i,
  bufferLimit: 50 * 1024 * 1024,
};

const rawArgs = process.argv.slice(2);
const forceRefresh = rawArgs.includes('--refresh');
const forceSetup = rawArgs.includes('--setup') || rawArgs.includes('--config');
const aiFlag = rawArgs.find(a => a.startsWith('--ai='));
const cliAiOverride = aiFlag ? aiFlag.split('=')[1].toLowerCase().trim() : '';
const args = rawArgs.filter(a => a !== '--refresh' && a !== '--setup' && a !== '--config' && !a.startsWith('--ai='));

// ============================================================================
// ADAPTADORES CLI SEGUROS
// ============================================================================
function runCli(cmd, cmdArgs = [], options = {}) {
  return spawnSync(cmd, cmdArgs, {
    encoding: 'utf8',
    maxBuffer: CONFIG.bufferLimit,
    env: { ...process.env, ...(options.env || {}) },
    ...options
  });
}

async function askQuestion(query) {
  const rl = readline.createInterface({ input, output });
  try {
    const answer = await rl.question(query);
    return answer.trim();
  } finally {
    rl.close();
  }
}

function isValidAiOutput(res, requireSpec = false) {
  if (!res || res.status !== 0) return false;
  const stdout = (res.stdout || '').trim();
  const stderr = (res.stderr || '').trim();
  if (!stdout || stdout.length < 20) return false;
  if (CONFIG.quotaRegex.test(stdout) || CONFIG.quotaRegex.test(stderr)) return false;
  if (/Permission denied|Approval check|Retry in an interactive session|No pude generar la especificaci|PENDIENTE-JIRA|el prompt no incluye/i.test(stdout)) {
    return false;
  }
  if (requireSpec && !/##\s+1\.\s*Requirements|##\s+3\.\s*Tasks/i.test(stdout)) {
    return false;
  }
  return true;
}

function runCopilotSilent(prompt, payload, { cwd, timeout = 60000 } = {}) {
  const copilotPrompt = `INSTRUCCIÓN CRÍTICA: Toda la información necesaria ya está incluida abajo en este prompt. NO ejecutes comandos de shell, NO busques archivos ni uses herramientas interactivas. Responde únicamente con el resultado Markdown solicitado.\n\n${prompt}\n\n${payload}`;
  return runCli('copilot', ['-s', '--no-ask-user', '-p', copilotPrompt], { cwd, timeout });
}

function callAnthropicApi(apiKey, systemPrompt, payload, timeoutMs = 60000) {
  const models = process.env.ANTHROPIC_MODEL
    ? [process.env.ANTHROPIC_MODEL]
    : ['claude-sonnet-4-5', 'claude-sonnet-4-20250514', 'claude-3-7-sonnet-latest', 'claude-3-5-sonnet-latest'];

  const tryModel = model => new Promise(resolve => {
    const body = JSON.stringify({
      model,
      max_tokens: 8192,
      temperature: 0.2,
      system: systemPrompt,
      messages: [{ role: 'user', content: payload || 'Genera el resultado solicitado.' }]
    });

    const req = https.request({
      hostname: 'api.anthropic.com',
      port: 443,
      path: '/v1/messages',
      method: 'POST',
      headers: {
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'content-type': 'application/json',
        'content-length': Buffer.byteLength(body)
      },
      timeout: timeoutMs
    }, res => {
      const chunks = [];
      res.on('data', c => chunks.push(c));
      res.on('end', () => {
        const raw = Buffer.concat(chunks).toString('utf8');
        if (res.statusCode >= 200 && res.statusCode < 300) {
          try {
            const parsed = JSON.parse(raw);
            const text = (parsed.content || []).filter(p => p.type === 'text').map(p => p.text).join('\n').trim();
            if (text) return resolve({ status: 0, stdout: text, stderr: '' });
          } catch {}
        }
        resolve({ status: res.statusCode || 1, stdout: '', stderr: raw });
      });
    });
    req.on('timeout', () => { req.destroy(); resolve({ status: 408, stdout: '', stderr: 'Timeout' }); });
    req.on('error', e => resolve({ status: 500, stdout: '', stderr: e.message }));
    req.write(body);
    req.end();
  });

  return (async () => {
    for (const m of models) {
      const r = await tryModel(m);
      if (r.status === 0 && r.stdout) return r;
    }
    return { status: 1, stdout: '', stderr: 'Anthropic API error' };
  })();
}

async function runAiInference(prompt, payload, options = {}) {
  const provider = (cliAiOverride || process.env.PREFERRED_AI_PROVIDER || 'gemini').toLowerCase().trim();
  const timeout = options.timeout || 60000;
  const cwd = options.cwd || process.cwd();
  const showStderr = options.showStderr || false;
  const requireSpec = options.requireSpec || false;

  if (provider === 'kiro' || provider === 'local') {
    return { status: 1, stdout: '', skipped: true, reason: 'Modo Kiro / IDE Local seleccionado (Self-Bootstrap).' };
  }

  if (provider === 'claude') {
    console.log("  🧠 Usando Claude como motor principal...");
    let res = runCli('claude', ['-p', prompt], { input: payload, cwd, timeout });
    if (isValidAiOutput(res, requireSpec)) return res;

    if (!isPlaceholderOrEmpty(process.env.ANTHROPIC_API_KEY)) {
      console.log("  🧠 Consultando Anthropic API...");
      res = await callAnthropicApi(process.env.ANTHROPIC_API_KEY, prompt, payload, timeout);
      if (isValidAiOutput(res, requireSpec)) return res;
    }

    console.log("  ⚠️  Claude no disponible. Intentando respaldo con Copilot / Gemini...");
    res = runCopilotSilent(prompt, payload, { cwd, timeout });
    if (isValidAiOutput(res, requireSpec)) return res;

    return { status: 1, stdout: '', reason: 'Claude CLI / Anthropic API no respondió o no tiene sesión activa.' };
  }

  if (provider === 'copilot') {
    console.log("  🐙 Usando GitHub Copilot CLI...");
    let res = runCopilotSilent(prompt, payload, { cwd, timeout });
    if (isValidAiOutput(res, requireSpec)) return res;

    if (!isPlaceholderOrEmpty(process.env.GEMINI_API_KEY)) {
      console.log("  ⚠️  Copilot CLI no disponible o sin cuota. Intentando respaldo con Gemini...");
      res = runCli('ask-gemini', [prompt], {
        input: payload,
        cwd,
        stdio: showStderr ? ['pipe', 'pipe', 'inherit'] : undefined
      });
      if (isValidAiOutput(res, requireSpec)) return res;
    }
    return { status: 1, stdout: '', reason: 'GitHub Copilot CLI no respondió o no tiene sesión activa.' };
  }

  // Default: gemini -> copilot -> fallback
  let res = { status: 1, stdout: '' };
  if (!isPlaceholderOrEmpty(process.env.GEMINI_API_KEY)) {
    res = runCli('ask-gemini', [prompt], {
      input: payload,
      cwd,
      stdio: showStderr ? ['pipe', 'pipe', 'inherit'] : undefined
    });
    if (isValidAiOutput(res, requireSpec)) return res;
  }

  console.log("  ⚠️  Gemini no disponible. Activando respaldo secundario con GitHub Copilot CLI...");
  res = runCopilotSilent(prompt, payload, { cwd, timeout });
  if (isValidAiOutput(res, requireSpec)) return res;

  return { status: 1, stdout: '', reason: 'Proveedores externos (Gemini y Copilot) no respondieron o no tienen cuota disponible.' };
}

// ============================================================================
// GESTIÓN DE GIT
// ============================================================================
function setupFeatureBranch(repoPath, branchName) {
  const repoName = path.basename(repoPath);

  const isDirty = runCli('git', ['-C', repoPath, 'status', '--porcelain']).stdout.trim().length > 0;
  if (isDirty) {
    console.warn(`  ⚠️  [${repoName}] Repositorio con cambios locales no guardados. No se alteró la rama por seguridad.`);
    return;
  }

  let baseBranch = 'main';
  if (runCli('git', ['-C', repoPath, 'show-ref', '--verify', '--quiet', 'refs/heads/master']).status === 0) {
    baseBranch = 'master';
  }

  runCli('git', ['-C', repoPath, 'checkout', baseBranch], { stdio: 'ignore' });
  runCli('git', ['-C', repoPath, 'pull', 'origin', baseBranch, '--ff-only'], { stdio: 'ignore' });

  const branchExists = runCli('git', ['-C', repoPath, 'show-ref', '--verify', '--quiet', `refs/heads/${branchName}`]).status === 0;
  if (branchExists) {
    runCli('git', ['-C', repoPath, 'checkout', branchName], { stdio: 'ignore' });
    console.log(`  🌿 [${repoName}] Rama activada: ${branchName}`);
  } else {
    runCli('git', ['-C', repoPath, 'checkout', '-b', branchName, baseBranch], { stdio: 'ignore' });
    console.log(`  🌿 [${repoName}] Nueva rama creada: ${branchName} (desde ${baseBranch})`);
  }
}

// ============================================================================
// MEMORIA DE ARQUITECTURA EFICIENTE
// ============================================================================
async function getRepoArchitectureContext(repoPath, force) {
  const repoName = path.basename(repoPath);
  const cacheDir = path.join(repoPath, '.kiro', 'cache');
  const cacheFile = path.join(cacheDir, 'repo-memory.json');

  let currentCommit = '';
  const revRes = runCli('git', ['-C', repoPath, 'rev-parse', 'HEAD']);
  if (revRes.status === 0) currentCommit = revRes.stdout.trim();

  let needRebuild = force;
  let cachedData = null;

  if (!needRebuild && fs.existsSync(cacheFile)) {
    try {
      cachedData = JSON.parse(fs.readFileSync(cacheFile, 'utf8'));
      if (!cachedData.summary || cachedData.commit !== currentCommit || CONFIG.quotaRegex.test(cachedData.summary)) {
        needRebuild = true;
      } else {
        console.log(`  ⚡ [${repoName}] Memoria arquitectónica en caché al día.`);
      }
    } catch {
      needRebuild = true;
    }
  } else {
    needRebuild = true;
  }

  let summary = cachedData && !CONFIG.quotaRegex.test(cachedData.summary || '') ? cachedData.summary : '';

  let pkgSummary = '';
  const pkgPath = path.join(repoPath, 'package.json');
  if (fs.existsSync(pkgPath)) {
    try {
      const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
      pkgSummary = JSON.stringify({
        name: pkg.name,
        dependencies: Object.keys(pkg.dependencies || {}),
        devDependencies: Object.keys(pkg.devDependencies || {})
      }, null, 2);
    } catch {}
  }

  let repoTree = '';
  const filesRes = runCli('git', ['-C', repoPath, 'ls-files']);
  if (filesRes.status === 0) {
    repoTree = filesRes.stdout
      .trim()
      .split('\n')
      .filter(f => f && !f.startsWith('node_modules/') && !f.startsWith('.kiro/') && !/\.(png|jpg|ico|svg|pdf|lock)$/i.test(f))
      .slice(0, 200)
      .join('\n');
  }

  if (needRebuild) {
    console.log(`  🤖 [${repoName}] Extrayendo arquitectura base...`);
    const prompt = `Analiza este repositorio (${repoName}). En máximo 10 líneas, indica el framework, carpetas principales de código y patrones de arquitectura empleados. Sé breve y directo.`;
    const payload = `DEPENDENCIAS:\n${pkgSummary}\n\nESTRUCTURA DE ARCHIVOS:\n${repoTree}`;

    // Cadena de resolución según PREFERRED_AI_PROVIDER
    const aiRes = await runAiInference(prompt, payload, { cwd: repoPath, timeout: 30000 });

    if (isValidAiOutput(aiRes)) {
      summary = aiRes.stdout.trim();
      fs.mkdirSync(cacheDir, { recursive: true });
      fs.writeFileSync(cacheFile, JSON.stringify({ repo: repoName, commit: currentCommit, summary }, null, 2), 'utf8');
    } else {
      // Fallback local sin IA para no bloquear
      summary = `Stack detectado en package.json: ${pkgSummary.slice(0, 300)}`;
    }
  }

  return `
<REPOSITORY name="${repoName}">
  <ARCHITECTURE_SUMMARY>
${summary || 'Estructura modular estándar.'}
  </ARCHITECTURE_SUMMARY>
  <KEY_FILES>
${repoTree}
  </KEY_FILES>
</REPOSITORY>`;
}

function normalizeKiroTasksIndentation(markdown) {
  const lines = markdown.split('\n');
  let inTasksSection = false;
  let insideUoW = false;

  return lines.map(line => {
    if (/^##\s+3\.\s+Tasks/i.test(line)) {
      inTasksSection = true;
      insideUoW = false;
      return line;
    }
    if (inTasksSection && /^##\s+[^3]/.test(line)) {
      inTasksSection = false;
      insideUoW = false;
      return line;
    }
    if (!inTasksSection) return line;
    if (/^###\s+/.test(line)) {
      insideUoW = false;
      return line;
    }
    if (/^-\s*\[\s*[xX ]?\s*\]\s*\*\*UoW\b/i.test(line.trim())) {
      insideUoW = true;
      return line.trim();
    }
    if (insideUoW && /^-\s*\[\s*[xX ]?\s*\]\s+/.test(line)) {
      return '  ' + line.trim();
    }
    return line;
  }).join('\n');
}

// ============================================================================
// INTERFAZ DE USUARIO (SELECCIÓN DE TICKET)
// ============================================================================
async function selectTicketInteractively() {
  console.log("==> 📋 Consultando tickets activos en Jira...");
  const res = runCli('jira-cli', ['my-issues', '--json']);
  if (res.status !== 0) {
    console.error("❌ No se pudo conectar a Jira con jira-cli. Verifica tus credenciales.");
    process.exit(1);
  }

  let issues = [];
  try {
    issues = JSON.parse(res.stdout);
  } catch {
    console.error("❌ Respuesta inválida de Jira (no es JSON válido).");
    process.exit(1);
  }

  if (!issues || issues.length === 0) {
    console.log("🎉 No tienes historias pendientes asignadas en Jira.");
    const manual = await askQuestion("Ingresa manualmente la clave del ticket (o presiona Enter para salir): ");
    if (!manual) process.exit(0);
    return manual.toUpperCase();
  }

  console.log("\n==========================================================================================================");
  console.log(`🎯 SELECCIONA LA HISTORIA PARA INICIAR EL FLUJO AI-DLC & SDD:`);
  console.log("==========================================================================================================");
  console.log(`${"#".padEnd(3)} | ${"CLAVE".padEnd(12)} | ${"ESTADO".padEnd(18)} | ${"COMPONENTE".padEnd(20)} | RESUMEN`);
  console.log("----------------------------------------------------------------------------------------------------------");

  issues.forEach((it, idx) => {
    const num = String(idx + 1).padEnd(3);
    const key = (it.key || '').padEnd(12);
    const status = (it.status || '').slice(0, 18).padEnd(18);
    const comp = ((it.components && it.components.join(',')) || '-').slice(0, 20).padEnd(20);
    const stInfo = it.subtasksCount > 0 ? ` (${it.subtasksCount} subtareas)` : '';
    console.log(`${num} | ${key} | ${status} | ${comp} | ${it.summary || ''}${stInfo}`);
  });
  console.log("==========================================================================================================\n");

  const answer = await askQuestion(`👉 Elige un número [1-${issues.length}] o escribe una clave (Enter = 1, 'q' = salir): `);
  if (/^(q|salir|exit)$/i.test(answer)) {
    console.log("👋 Operación cancelada.");
    process.exit(0);
  }
  if (!answer) return issues[0].key;
  if (/^\d+$/.test(answer)) {
    const idx = parseInt(answer, 10) - 1;
    if (idx >= 0 && idx < issues.length) return issues[idx].key;
    console.error(`❌ Número fuera de rango (1-${issues.length}).`);
    process.exit(1);
  }
  return answer.toUpperCase();
}

function getLocalGitRepos(projectsBaseDirs) {
  const dirs = Array.isArray(projectsBaseDirs) ? projectsBaseDirs : [projectsBaseDirs];
  const results = [];
  const seenPaths = new Set();
  const IGNORED_DIRS = new Set([
    'node_modules', 'dist', 'build', 'target', 'coverage', 'vendor',
    '.git', '.kiro', '.vscode', '.idea', 'src', 'test', 'tests', '__tests__',
    'lib', 'assets', 'public', 'docs', 'bin', 'scripts', 'out', 'tmp'
  ]);

  function scanDir(rootDir, currentDir, depth) {
    if (depth > 5) return;
    let entries = [];
    try {
      entries = fs.readdirSync(currentDir, { withFileTypes: true });
    } catch {
      return;
    }

    for (const entry of entries) {
      if (!entry.isDirectory()) continue;
      if (entry.name.startsWith('.') || IGNORED_DIRS.has(entry.name)) continue;

      const fullPath = path.join(currentDir, entry.name);
      if (fs.existsSync(path.join(fullPath, '.git')) && !seenPaths.has(fullPath)) {
        seenPaths.add(fullPath);
        const rel = path.relative(rootDir, fullPath) || entry.name;
        results.push({ name: entry.name, relativePath: rel, path: fullPath, source: 'local' });
      }
      // Seguir descendiendo hasta depth 5 por si una carpeta contenedora tiene un .git accidental
      scanDir(rootDir, fullPath, depth + 1);
    }
  }

  for (const base of dirs) {
    if (!fs.existsSync(base)) continue;
    if (fs.existsSync(path.join(base, '.git')) && !seenPaths.has(base)) {
      seenPaths.add(base);
      results.push({ name: path.basename(base), relativePath: path.basename(base), path: base, source: 'local' });
    }
    scanDir(base, base, 1);
  }

  return results.sort((a, b) => a.relativePath.localeCompare(b.relativePath));
}

function searchGitHubRepos(keyword) {
  const ghRepos = [];
  if (!keyword || keyword.length < 2) return ghRepos;

  const userRes = runCli('gh', ['api', 'user', '--jq', '.login'], { timeout: 4000 });
  if (userRes.status !== 0 || !userRes.stdout.trim()) return ghRepos;

  const owners = [userRes.stdout.trim()];
  const orgsRes = runCli('gh', ['api', 'user/orgs', '--jq', '.[].login'], { timeout: 4000 });
  if (orgsRes.status === 0 && orgsRes.stdout.trim()) {
    orgsRes.stdout.trim().split('\n').forEach(o => {
      if (o.trim()) owners.push(o.trim());
    });
  }

  const ownerArgs = [];
  for (const o of owners) {
    ownerArgs.push('--owner', o);
  }

  const searchRes = runCli('gh', [
    'search', 'repos', keyword,
    ...ownerArgs,
    '--limit', '15',
    '--json', 'fullName,name,url'
  ], { timeout: 8000 });

  if (searchRes.status === 0 && searchRes.stdout.trim()) {
    try {
      const parsed = JSON.parse(searchRes.stdout);
      if (Array.isArray(parsed)) {
        for (const r of parsed) {
          ghRepos.push({
            name: r.name,
            fullName: r.fullName,
            url: r.url,
            source: 'github'
          });
        }
      }
    } catch {}
  }
  return ghRepos;
}

async function findRepositoriesInteractively(projectsBaseDirs, currentGitRoot, hasComponentsInJira) {
  const cloneTargetBase = Array.isArray(projectsBaseDirs) ? projectsBaseDirs[0] : projectsBaseDirs;
  if (!hasComponentsInJira) {
    console.log("\n=================================================================================");
    console.log("⚠️  ALERTA: Esta Historia de Usuario en Jira NO tiene 'Components' asignados.");
    console.log("💡 Tip: Agrega el componente en Jira para futuras ejecuciones, o búscalo aquí.");
    console.log("=================================================================================");
  } else {
    console.log("\n=================================================================================");
    console.log("⚠️  No se encontraron localmente los componentes definidos en Jira.");
    console.log("💡 Puedes buscar el repositorio manualmente en tus carpetas locales o en GitHub.");
    console.log("=================================================================================");
  }

  const allLocal = getLocalGitRepos(projectsBaseDirs);
  const accumulatedPaths = [];
  const rl = readline.createInterface({ input, output });

  try {
    while (true) {
      if (accumulatedPaths.length > 0) {
        console.log(`\n📌 Componentes seleccionados (${accumulatedPaths.length}): ${accumulatedPaths.map(p => path.basename(p)).join(', ')}`);
      } else if (currentGitRoot) {
        console.log(`\n📂 Repositorio actual detectado: ${path.basename(currentGitRoot)}`);
      }

      const promptHint = accumulatedPaths.length > 0
        ? `🔍 Escribe otro nombre para buscar y agregar (o '*' para ver todos) [Enter = continuar con estos ${accumulatedPaths.length}]: `
        : (currentGitRoot
          ? `🔍 Escribe parte del nombre (ej: 'host', o '*' para listar todos) [Enter = usar '${path.basename(currentGitRoot)}']: `
          : `🔍 Escribe parte del nombre del repo para buscar en local y GitHub (ej: 'host') [Enter = listar todos locales]: `);

      const query = (await rl.question(promptHint)).trim();

      if (!query && accumulatedPaths.length > 0) {
        return accumulatedPaths;
      }

      if (!query && currentGitRoot && accumulatedPaths.length === 0) {
        return [currentGitRoot];
      }

      const listAll = !query || ['*', 'all', 'todos'].includes(query.toLowerCase());
      const qLower = listAll ? '' : query.toLowerCase();
      const matches = allLocal.filter(r => !qLower || r.relativePath.toLowerCase().includes(qLower) || r.name.toLowerCase().includes(qLower));

      let ghMatches = [];
      if (!listAll && query.length >= 2) {
        console.log(`  🔎 Buscando '${query}' en local y en tus organizaciones de GitHub...`);
        ghMatches = searchGitHubRepos(query);
      }

      const localNames = new Set(matches.map(m => m.name.toLowerCase()));
      const remoteOnly = ghMatches.filter(g => !localNames.has(g.name.toLowerCase()));
      const combined = listAll ? matches : [...matches, ...remoteOnly.slice(0, 15)];

      if (combined.length === 0) {
        console.log(`  ⚠️  No se encontraron repositorios que coincidan con '${query}'. Intenta con otra palabra clave.`);
        continue;
      }

      console.log(`\n📦 Repositorios encontrados${!listAll ? ` para '${query}'` : ` (${combined.length} locales)`}:`);
      combined.forEach((repo, i) => {
        if (repo.source === 'local') {
          console.log(`  [${i + 1}] 📁 [Local]  ${repo.relativePath}`);
        } else {
          console.log(`  [${i + 1}] ☁️  [GitHub] ${repo.fullName} (se clonará en ${cloneTargetBase})`);
        }
      });
      console.log(`  [0] 🔄 Buscar otro nombre`);

      const selAns = (await rl.question("\n👉 Selecciona el número (puedes elegir varios separados por coma, ej: 1, 2): ")).trim();
      if (selAns === '0' || !selAns) continue;

      const indices = selAns
        .split(',')
        .map(s => parseInt(s.trim(), 10) - 1)
        .filter(idx => idx >= 0 && idx < combined.length);

      if (indices.length === 0) {
        console.log("  ⚠️  Selección inválida. Intenta de nuevo.");
        continue;
      }

      for (const idx of indices) {
        const item = combined[idx];
        if (item.source === 'local') {
          if (!accumulatedPaths.includes(item.path)) accumulatedPaths.push(item.path);
        } else {
          const destPath = path.join(cloneTargetBase, item.name);
          console.log(`\n☁️  Seleccionaste el repositorio remoto '${item.fullName}'.`);
          const cloneAns = (await rl.question(
            `👉 ¿Deseas clonarlo en '${destPath}'? [s = Clonar / n = Cancelar / o pega ruta local]: `
          )).trim();

          const ansLower = cloneAns.toLowerCase();
          if (['s', 'si', 'y', 'yes'].includes(ansLower)) {
            console.log(`\n==> 📥 Clonando ${item.fullName} en ${destPath}...`);
            const cloneRes = runCli('gh', ['repo', 'clone', item.fullName, destPath], { stdio: 'inherit' });
            if (cloneRes.status === 0 && fs.existsSync(destPath)) {
              if (!accumulatedPaths.includes(destPath)) accumulatedPaths.push(destPath);
            } else {
              console.error(`  ❌ No se pudo clonar ${item.fullName}.`);
            }
          } else if (cloneAns && !['n', 'no'].includes(ansLower)) {
            const expanded = cloneAns.startsWith('~/') ? path.join(os.homedir(), cloneAns.slice(2)) : cloneAns;
            const resolvedCustom = path.resolve(expanded);
            if (fs.existsSync(path.join(resolvedCustom, '.git'))) {
              console.log(`  ✔ Usando repositorio local indicado: ${resolvedCustom}`);
              if (!accumulatedPaths.includes(resolvedCustom)) accumulatedPaths.push(resolvedCustom);
            } else {
              console.log(`  ⚠️  La ruta '${resolvedCustom}' no existe o no es un repositorio Git. Se omitió.`);
            }
          } else {
            console.log(`  ℹ️  Clonación de '${item.fullName}' cancelada.`);
          }
        }
      }
    }
  } finally {
    rl.close();
  }
}

// ============================================================================
// FLUJO PRINCIPAL
// ============================================================================
async function main() {
  // 0. Comprobación y Onboarding didáctico (primera ejecución o --setup)
  await runInteractiveOnboarding(forceSetup);
  if (forceSetup && args.length === 0) {
    process.exit(0);
  }

  let ticket = args[0];
  if (!ticket || ticket.startsWith('-')) {
    ticket = await selectTicketInteractively();
  } else {
    ticket = ticket.toUpperCase();
  }

  if (!/^[A-Z][A-Z0-9]+-\d+$/.test(ticket)) {
    console.error(`❌ Formato de ticket inválido: '${ticket}'. Ejemplo esperado: PROJ-1234`);
    process.exit(1);
  }

  const ASSETS_DIR = path.join(os.tmpdir(), `${ticket}-assets`);
  fs.mkdirSync(ASSETS_DIR, { recursive: true });

  console.log(`\n==> 🔍 [AI-DLC Phase 1] Consultando ${ticket} en Jira...`);
  const jiraRes = runCli('jira-cli', [ticket]);
  if (jiraRes.status !== 0) {
    console.error(`❌ Error consultando Jira: ${jiraRes.stderr || jiraRes.stdout}`);
    process.exit(1);
  }

  const jiraOutput = jiraRes.stdout;

  const titleMatch = jiraOutput.match(/^JIRA TICKET:\s*[A-Z0-9]+-[0-9]+\s*-\s*(.+)$/im);
  const taskTitle = titleMatch ? titleMatch[1].trim() : `Tarea ${ticket}`;

  const compMatch = jiraOutput.match(/^COMPONENTS:\s*(.+)$/m);
  const components = compMatch && compMatch[1].trim() ? compMatch[1].split(',').map(c => c.trim()).filter(Boolean) : [];

  const figmaMatch = jiraOutput.match(/^FIGMA_URLS:\s*(.+)$/m);
  const figmaUrls = figmaMatch && figmaMatch[1].trim() ? figmaMatch[1].split(/\s+/).filter(u => /^https?:\/\/.*figma\.com/i.test(u)) : [];

  if (components.length > 0) {
    console.log(`==> 🧩 Componentes detectados en Jira: ${components.join(', ')}`);
  }

  const slug = taskTitle.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 35);
  const branchName = slug ? `feature/${ticket}-${slug}` : `feature/${ticket}`;

  // Localizar repositorios locales (soporta carpetas anidadas y múltiples rutas base)
  const targetRepos = [];
  if (components.length > 0) {
    const allLocalRepos = getLocalGitRepos(CONFIG.projectsBaseDirs);

    for (const comp of components) {
      const compSlug = comp.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const exactMatch = allLocalRepos.find(r => r.name.toLowerCase() === comp.toLowerCase());
      const slugMatch = exactMatch || allLocalRepos.find(r => {
        const dirSlug = r.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        return dirSlug === compSlug || dirSlug.includes(compSlug);
      });

      if (slugMatch && !targetRepos.includes(slugMatch.path)) {
        console.log(`  ✔ Repositorio encontrado: ${slugMatch.path}`);
        targetRepos.push(slugMatch.path);
      } else if (!slugMatch) {
        console.log(`  ⚠️ No se encontró el proyecto '${comp}' en tus carpetas configuradas.`);
      }
    }
  }

  if (targetRepos.length === 0) {
    const gitRootRes = runCli('git', ['rev-parse', '--show-toplevel']);
    const currentGitRoot = (gitRootRes.status === 0 && gitRootRes.stdout.trim()) ? gitRootRes.stdout.trim() : '';
    const selectedRepos = await findRepositoriesInteractively(CONFIG.projectsBaseDirs, currentGitRoot, components.length > 0);
    targetRepos.push(...selectedRepos);
  }

  if (targetRepos.length === 0) {
    console.error(`❌ No se seleccionó ningún repositorio válido.`);
    process.exit(1);
  }

  // Preparar ramas y extraer arquitectura
  console.log("\n==> 🧠 [AI-DLC Phase 1] Preparando ramas y memoria técnica...");
  let reposContext = '';
  for (const repo of targetRepos) {
    setupFeatureBranch(repo, branchName);
    reposContext += await getRepoArchitectureContext(repo, forceRefresh);
  }

  // Descargar recursos de Figma si existen
  let figmaContext = '';
  for (const fUrl of figmaUrls) {
    console.log(`==> 🎨 [AI-DLC Design Ingestion] Descargando diseño desde Figma: ${fUrl}`);
    const figmaRes = runCli('figma-cli', [fUrl, ASSETS_DIR]);
    if (figmaRes.status === 0 && figmaRes.stdout.trim()) {
      figmaContext += `\n<FIGMA_FILE url="${fUrl}">\n${figmaRes.stdout.slice(0, 3000)}\n</FIGMA_FILE>`;
    }
  }

  // Mover ticket a "En desarrollo" en Jira
  console.log("==> 🚀 Evaluando estado en Jira...");
  runCli('jira-cli', ['start', ticket], { stdio: 'inherit' });

  // ==========================================================================
  // CONSTRUCCIÓN DEL PROMPT MAESTRO (COBERTURA TOTAL + ANÁLISIS DE BRECHA)
  // ==========================================================================
  console.log("==> 🤖 [AI-DLC Phase 2] Construyendo Plan Maestro (Fidelidad Jira + Análisis de Brecha)...");
  const reposListStr = targetRepos.map(r => path.basename(r)).join(', ');

  const systemPrompt = `Eres un Staff Software Architect experto en AI-DLC, Spec-Driven Development (SDD) y BDD.
Tu misión es generar el artefacto maestro de especificación y ejecución (.md) para el ticket ${ticket}: "${taskTitle}".

================================================================================
REGLAS INVIOLABLES DE ARQUITECTURA Y NEGOCIO:
================================================================================
1. FIDELIDAD ESTRICTA AL DOMINIO DEL TICKET (ZERO-HALLUCINATION):
   - Basa las reglas, entidades y terminología estrictamente en los 'ACCEPTANCE CRITERIA' y la 'DESCRIPTION' de Jira.
   - Prohibido asumir tecnologías, bases de datos o frameworks que no correspondan al stack real de los repositorios y Jira.

2. COBERTURA TOTAL DE SUBTAREAS DE JIRA (BASE OBLIGATORIA):
   - Cada una de las 'TECHNICAL SUBTASKS' de Jira DEBE convertirse en una Unidad de Trabajo (UoW) en '## 3. Tasks'.
   - Conserva textualmente la clave y el título de cada subtarea técnica de Jira (ej: [CLAVE] Título de la tarea).
   - Detalla para cada una: el archivo exacto en [${reposListStr}], las entidades/tablas involucradas y la lógica específica a implementar.

3. ANÁLISIS DE BRECHA (GAP ANALYSIS):
   - Compara minuciosamente los 'ACCEPTANCE CRITERIA' y la 'DESCRIPTION' contra las subtareas técnicas.
   - Si detectas que algún requerimiento o criterio NO tiene una subtarea que lo cubra (o si el desarrollador no creó subtareas en Jira), AGREGA las Unidades de Trabajo necesarias marcadas con: "[Sugerido por Arquitectura]".

4. CONCISIÓN EN SECCIONES 1 Y 2 PARA EVITAR TEXTO CORTADO:
   - En '1.1 Problem Statement', sé conciso (3-4 líneas).
   - En '1.2 Acceptance Criteria (BDD)', usa un Scenario Outline con tabla de Examples resumiendo los criterios de Jira.
   - En '2.1 File Mapping', lista de archivos por repositorio.
   - En '2.2 Business Rules & Acceptance Matrix', tabla Markdown cruzando criterios con la regla/rama esperada.
   - En '2.3 Contracts', interfaces TypeScript esenciales (DTOs / queries).
   - En '2.4 Quality Guardrails', métricas de calidad (cobertura >= 85%, 0 'any', complejidad <= 10).
   - Dedica el mayor detalle y profundidad técnica a '## 3. Tasks'.

================================================================================
FORMATO OBLIGATORIO DE SALIDA:
================================================================================
# SDD & AI-DLC Spec: ${ticket} - ${taskTitle}

## 1. Requirements
- **1.1 Problem Statement**: Resumen de alcance.
- **1.2 Acceptance Criteria (BDD)**: Scenario Outline Gherkin conciso con tabla de Examples.

## 2. Technical Design
- **2.1 File Mapping**: Archivos específicos a modificar o crear en [${reposListStr}].
- **2.2 Business Rules & Acceptance Matrix**: Tabla de correspondencia Criterio -> Regla/Valor esperado.
- **2.3 Contracts**: Interfaces TypeScript clave.
- **2.4 Quality Guardrails**: Reglas de calidad y cobertura.

## 3. Tasks
(Genera las UoW obligatorias de Jira y las UoW [Sugerido por Arquitectura] si faltan pasos para cubrir la historia):
- [ ] **UoW 1: [CLAVE-JIRA] Título descriptivo**
  - [ ] En \`repositorio/ruta/archivo.ts\`, detalle técnico preciso del cambio.
  - [ ] Self-Check: Validación de compilación y pruebas unitarias con cobertura >= 85%.`;

  const fullContextPayload = `
<JIRA_CONTEXT>
${jiraOutput}
</JIRA_CONTEXT>

<REPOSITORIES_CONTEXT>
${reposContext}
</REPOSITORIES_CONTEXT>
${figmaContext ? `\n<FIGMA_DESIGN>\n${figmaContext}\n</FIGMA_DESIGN>` : ''}`;

  let specContent = '';
  try {
    const aiRes = await runAiInference(systemPrompt, fullContextPayload, {
      timeout: 60000,
      cwd: targetRepos[0],
      showStderr: true,
      requireSpec: true
    });

    if (isValidAiOutput(aiRes)) {
      specContent = normalizeKiroTasksIndentation(aiRes.stdout.trim());
    } else {
      throw new Error(aiRes.reason || "Proveedores externos (Gemini y Copilot) no respondieron o no tienen cuota disponible.");
    }
  } catch (err) {
    // 3. SALVAVIDAS UNIVERSAL: Kiro Self-Bootstrap
    console.log(`\nℹ️  [Self-Bootstrap] ${err.message}`);
    console.log("🛡️  Activando modo 'Kiro / IDE Local': Ensamblando artefacto SDD base directamente desde Jira...");

    // Extraer subtareas técnicas directamente de Jira
    const subtaskRegex = /###\s+\[Sub-task\]\s+([A-Z0-9]+-[0-9]+):\s+([^\n(]+)/gi;
    const subtasks = [];
    let m;
    while ((m = subtaskRegex.exec(jiraOutput)) !== null) {
      subtasks.push({ key: m[1].trim(), title: m[2].trim() });
    }

    let tasksMarkdown = '';
    if (subtasks.length > 0) {
      tasksMarkdown = subtasks.map((st, i) => 
`- [ ] **UoW ${i + 1}: [${st.key}] ${st.title}**
  - [ ] Implementar los cambios correspondientes en los repositorios: [${reposListStr}].
  - [ ] Self-Check: Validación de compilación y pruebas unitarias con cobertura >= 85%.`
      ).join('\n\n');
    } else {
      tasksMarkdown = `- [ ] **UoW 1: [${ticket}] Implementación del requerimiento principal**
  - [ ] Implementar la solución técnica según los Criterios de Aceptación de Jira.
  - [ ] Self-Check: Pruebas unitarias con cobertura >= 85%.`;
    }

    specContent = `# SDD & AI-DLC Spec: ${ticket} - ${taskTitle}

## 1. Requirements
- **1.1 Problem Statement**:
  ${taskTitle}

- **1.2 Acceptance Criteria & Contexto de Jira**:
\`\`\`text
${jiraOutput.slice(0, 5000)}
\`\`\`

## 2. Technical Design
- **2.1 File Mapping**: Repositorios asignados [${reposListStr}].
- **2.2 Quality Guardrails**: Cobertura unitaria >= 85%, tipado estricto (0 'any'), complejidad <= 10.

## 3. Tasks
(Esqueleto generado automáticamente desde las subtareas de Jira. Kiro Agent enriquecerá y validará la brecha durante el inicio):

${tasksMarkdown}
`;
  }

  // ==========================================================================
  // DISTRIBUCIÓN DE ARTEFACTOS EN LOS REPOSITORIOS
  // ==========================================================================
  let mainSpecPath = '';
  const mainRepoDir = targetRepos[0];

  for (const repo of targetRepos) {
    const specsDir = path.join(repo, '.kiro', 'specs');
    const steeringDir = path.join(repo, '.kiro', 'steering');
    const assetsDest = path.join(specsDir, 'assets');

    fs.mkdirSync(specsDir, { recursive: true });
    fs.mkdirSync(steeringDir, { recursive: true });
    fs.mkdirSync(assetsDest, { recursive: true });

    const specPath = path.join(specsDir, `${ticket}-spec.md`);
    fs.writeFileSync(specPath, specContent, 'utf8');
    if (!mainSpecPath) mainSpecPath = specPath;

    if (fs.existsSync(ASSETS_DIR)) {
      const assetFiles = fs.readdirSync(ASSETS_DIR);
      for (const af of assetFiles) {
        fs.copyFileSync(path.join(ASSETS_DIR, af), path.join(assetsDest, af));
      }
    }

    const steeringContent = `# Protocolo de Ejecución AI-DLC & SDD: ${ticket} - ${taskTitle}
- Repositorio objetivo: \`${path.basename(repo)}\`
- Rama activa: \`${branchName}\`
- Artefacto Maestro: \`.kiro/specs/${ticket}-spec.md\`

## Ciclo de Ejecución del Agente (AI-DLC Loop):
Para cada Unidad de Trabajo (UoW) en \`## 3. Tasks\` (tanto las de Jira como las [Sugerido por Arquitectura]):
1. **Context Analysis:** Inspecciona únicamente los archivos involucrados en la UoW actual.
2. **Implement:** Aplica los cambios requeridos respetando principios SOLID y tipado estricto (0 \`any\`).
3. **Verify:** Ejecuta la suite de pruebas unitarias asegurando cobertura >= 85%.
4. **Advance:** Marca el checkbox \`[x]\` en \`.kiro/specs/${ticket}-spec.md\` tras verificar el paso.\n`;

    fs.writeFileSync(path.join(steeringDir, 'ticket-context.md'), steeringContent, 'utf8');
  }

  fs.rmSync(ASSETS_DIR, { recursive: true, force: true });

  console.log("\n==========================================================");
  console.log(`✅ Orquestación AI-DLC + SDD finalizada para ${ticket}`);
  console.log(`🌿 Rama: ${branchName}`);
  console.log(`📄 Especificación: ${mainSpecPath}`);

function savePreferredEditor(editorKey) {
  try {
    fs.mkdirSync(CONFIG_DIR, { recursive: true });
    let lines = [];
    if (fs.existsSync(CONFIG_FILE)) {
      lines = fs.readFileSync(CONFIG_FILE, 'utf8').split('\n');
      lines = lines.filter(l => !l.trim().startsWith('PREFERRED_EDITOR='));
    }
    lines.push(`PREFERRED_EDITOR="${editorKey}"`);
    fs.writeFileSync(CONFIG_FILE, lines.filter(Boolean).join('\n').trim() + '\n', { mode: 0o600 });
    process.env.PREFERRED_EDITOR = editorKey;
    console.log(`💾 Editor predeterminado '${editorKey}' guardado en: ${CONFIG_FILE}`);
  } catch {}
}

  if (targetRepos.length > 0 && mainSpecPath) {
    const prefEditor = (process.env.PREFERRED_EDITOR || '').toLowerCase().trim();
    const defaultOption =
      prefEditor === 'antigravity' || prefEditor === 'agy' ? '2'
      : (prefEditor === 'vscode' || prefEditor === 'code') ? '3'
      : prefEditor === 'cursor' ? '4'
      : prefEditor === 'kiro-cli' || prefEditor === 'cli' ? '5'
      : prefEditor === 'claude' || prefEditor === 'claude-cli' ? '6'
      : prefEditor === 'copilot' || prefEditor === 'copilot-cli' ? '7'
      : '1';

    console.log("\n==========================================================");
    console.log("🎯 ¿Dónde deseas abrir el proyecto y la especificación?");
    console.log(`  1) 🖥️   Kiro IDE ${defaultOption === '1' ? '[Predeterminado - Enter]' : ''}`);
    console.log(`  2) 🪐  Antigravity IDE ${defaultOption === '2' ? '[Predeterminado - Enter]' : ''}`);
    console.log(`  3) 💻  Visual Studio Code (VS Code) ${defaultOption === '3' ? '[Predeterminado - Enter]' : ''}`);
    console.log(`  4) ⚡  Cursor ${defaultOption === '4' ? '[Predeterminado - Enter]' : ''}`);
    console.log(`  5) 📟  Kiro CLI (chat interactivo en terminal) ${defaultOption === '5' ? '[Predeterminado - Enter]' : ''}`);
    console.log(`  6) 🧠  Claude Code CLI (chat interactivo en terminal) ${defaultOption === '6' ? '[Predeterminado - Enter]' : ''}`);
    console.log(`  7) 🐙  GitHub Copilot CLI (chat interactivo en terminal) ${defaultOption === '7' ? '[Predeterminado - Enter]' : ''}`);
    console.log("  8) ✏️   Otro editor (escribe comando: webstorm, idea, zed, etc.)");
    console.log("  9) 🚪  Ninguno (solo preparar ramas y especificación)");
    console.log("==========================================================");

    const rl = readline.createInterface({ input, output });
    let choice = defaultOption;
    let customCmd = '';
    try {
      const ans = await rl.question(`👉 Selecciona una opción [1-9, Enter = ${defaultOption}]: `);
      choice = ans.trim() || defaultOption;

      if (choice === '8') {
        const cmdAns = await rl.question("👉 Ingresa el comando para abrir tu editor (ej: webstorm, idea, zed): ");
        customCmd = cmdAns.trim();
      }
    } finally {
      rl.close();
    }

    let openedKey = '';
    const norm = choice.toLowerCase();
    const promptInput = `Iniciando ${ticket}: ${taskTitle}. Revisa la especificación en ${mainSpecPath} y comencemos con la primera Unidad de Trabajo (UoW 1).`;

    if (norm === '1' || norm === 'kiro') {
      console.log("\n🚀 Abriendo repositorios y especificación en Kiro IDE...");
      let opened = false;
      if (runCli('kiro', ['-r', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      else if (process.platform === 'darwin') {
        if (runCli('open', ['-a', 'Kiro', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      }
      if (opened) console.log(`✔ Kiro IDE iniciado.`);
      else console.log(`⚠️ No se detectó Kiro IDE en este equipo. Puedes abrir la spec en: ${mainSpecPath}`);
      openedKey = 'kiro';
    } else if (norm === '2' || norm === 'antigravity' || norm === 'agy') {
      console.log("\n🚀 Abriendo repositorios y especificación en Antigravity IDE...");
      let opened = false;
      if (runCli('antigravity', [...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      else if (runCli('agy', [...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      else if (process.platform === 'darwin') {
        if (runCli('open', ['-a', 'Antigravity', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
        else if (runCli('open', ['-a', 'Antigravity IDE', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      }
      if (opened) console.log(`✔ Antigravity IDE iniciado.`);
      else console.log(`⚠️ No se detectó Antigravity instalado. Puedes abrir la spec en: ${mainSpecPath}`);
      openedKey = 'antigravity';
    } else if (norm === '3' || norm === 'vscode' || norm === 'code') {
      console.log("\n🚀 Abriendo repositorios y especificación en Visual Studio Code...");
      let opened = false;
      if (runCli('code', [...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      else if (process.platform === 'darwin') {
        if (runCli('open', ['-a', 'Visual Studio Code', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
        else if (runCli('open', ['-a', 'Code', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      }
      if (opened) console.log(`✔ Visual Studio Code iniciado.`);
      else console.log(`⚠️ No se detectó VS Code instalado o el comando 'code' en PATH.`);
      openedKey = 'vscode';
    } else if (norm === '4' || norm === 'cursor') {
      console.log("\n🚀 Abriendo repositorios y especificación en Cursor...");
      let opened = false;
      if (runCli('cursor', [...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      else if (process.platform === 'darwin') {
        if (runCli('open', ['-a', 'Cursor', ...targetRepos, mainSpecPath], { stdio: 'ignore' }).status === 0) opened = true;
      }
      if (opened) console.log(`✔ Cursor iniciado.`);
      else console.log(`⚠️ No se detectó Cursor instalado en este equipo.`);
      openedKey = 'cursor';
    } else if (norm === '5' || norm === 'cli' || norm === 'kiro-cli') {
      console.log("\n💻 Iniciando Kiro CLI en la terminal...");
      runCli('kiro-cli', ['chat', promptInput], { cwd: mainRepoDir, stdio: 'inherit' });
      openedKey = 'kiro-cli';
    } else if (norm === '6' || norm === 'claude' || norm === 'claude-cli') {
      console.log("\n🧠 Iniciando Claude Code CLI en la terminal...");
      const claudeRes = runCli('claude', [promptInput], { cwd: mainRepoDir, stdio: 'inherit' });
      if (claudeRes.status !== 0) {
        console.log("⚠️ No se pudo ejecutar 'claude'. Instálalo con: npm install -g @anthropic-ai/claude-code");
      }
      openedKey = 'claude';
    } else if (norm === '7' || norm === 'copilot' || norm === 'copilot-cli') {
      console.log("\n🐙 Iniciando GitHub Copilot CLI en la terminal...");
      const copRes = runCli('copilot', ['-i', promptInput], { cwd: mainRepoDir, stdio: 'inherit' });
      if (copRes.status !== 0) {
        runCli('copilot', { cwd: mainRepoDir, stdio: 'inherit' });
      }
      openedKey = 'copilot';
    } else if (norm === '8' && customCmd) {
      console.log(`\n🚀 Abriendo con comando personalizado '${customCmd}'...`);
      runCli(customCmd, [...targetRepos, mainSpecPath], { stdio: 'inherit' });
      openedKey = customCmd;
    } else {
      console.log(`\n✔ Todo listo. Especificación guardada en: ${mainSpecPath}`);
    }

    // Si aún no tenía preferencia guardada, preguntar si desea recordarla
    if (!process.env.PREFERRED_EDITOR && openedKey && openedKey !== 'none' && openedKey !== '9') {
      const rlPref = readline.createInterface({ input, output });
      try {
        const prefAns = await rlPref.question(`👉 ¿Deseas recordar '${openedKey}' como tu editor predeterminado? [s/N]: `);
        if (['s', 'si', 'y', 'yes'].includes(prefAns.trim().toLowerCase())) {
          savePreferredEditor(openedKey);
        }
      } finally {
        rlPref.close();
      }
    }
    console.log(`📄 Especificación activa: ${mainSpecPath}\n`);
  }
  console.log("==========================================================");
}

main().catch(err => {
  console.error("❌ Error inesperado:", err.message);
  process.exit(1);
});
