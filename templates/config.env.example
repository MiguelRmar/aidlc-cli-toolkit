# ==============================================================================
# AIDLC Toolkit - Archivo de Configuración de Entorno
# Ubicación de destino: ~/.config/aidlc/config.env
# ==============================================================================

# Directorio raíz donde clonas tus repositorios de desarrollo
PROJECTS_BASE_DIR="$HOME/Documents/GitHub"

# ------------------------------------------------------------------------------
# Atlassian Jira & Confluence
# ------------------------------------------------------------------------------
# URL base de tu instancia de Atlassian (sin barra al final)
JIRA_URL="https://tu-dominio.atlassian.net"
CONFLUENCE_URL="https://tu-dominio.atlassian.net/wiki"

# Correo electrónico asociado a tu cuenta de Atlassian
JIRA_USERNAME="tu-correo@empresa.com"
CONFLUENCE_USERNAME="tu-correo@empresa.com"

# Token de API generado en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=""
CONFLUENCE_API_TOKEN=""

# ------------------------------------------------------------------------------
# Figma
# ------------------------------------------------------------------------------
# Token de acceso personal generado en Ajustes de Cuenta de Figma
FIGMA_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# Gemini API (Motor de IA Primario)
# ------------------------------------------------------------------------------
# API Key obtenida en Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# SonarQube / SonarCloud (Opcional)
# ------------------------------------------------------------------------------
SONAR_HOST_URL="https://sonarcloud.io"
SONAR_TOKEN=""

